# InfinityFree Root .htaccess
# ===========================
# Place this file in the htdocs root folder on InfinityFree
# This redirects all requests to the public/ folder

RewriteEngine On

# If the request is for a real file or directory in htdocs, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, redirect everything to public folder
RewriteRule ^(.*)$ public/$1 [L]
